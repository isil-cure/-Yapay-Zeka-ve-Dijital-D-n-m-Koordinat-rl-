generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  fullName     String
  department   String
  role         String              @default("STAFF") // "ADMIN" | "STAFF"
  createdAt    DateTime            @default(now())

  assignedAssets    Asset[]             @relation("UserAssignedAssets")
  assignmentHistory AssignmentHistory[]

  @@map("users")
}

model Asset {
  id               String              @id @default(uuid())
  assetTag         String              @unique
  name             String
  brand            String
  model            String
  serialNumber     String              @unique
  purchaseDate     DateTime
  status           String              @default("IN_STOCK") // "ACTIVE" | "IN_STOCK" | "IN_REPAIR" | "SCRAPPED"
  qrCode           String
  assignedToUserId String?
  assignedToUser   User?               @relation("UserAssignedAssets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  assignmentLogs   AssignmentHistory[]

  @@map("assets")
}

model AssignmentHistory {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "ASSIGN" | "RETURN" | "STATUS_CHANGE"
  notes     String?
  createdAt DateTime @default(now())

  @@map("assignment_history")
}
